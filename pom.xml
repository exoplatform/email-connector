<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.exoplatform.addons</groupId>
    <artifactId>addons-exo-parent-pom</artifactId>
    <version>21-M01</version>
  </parent>
  <groupId>org.exoplatform.addons.email-connector</groupId>
  <artifactId>email-connector-parent</artifactId>
  <version>7.3.x-meeds-qaui-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>eXo Email Connector - Parent POM</name>
  <description>eXo Email Connector Addon</description>
  <modules>
    <module>email-connector-services</module>
    <module>email-connector-webapps</module>
    <module>email-connector-packaging</module>
  </modules>
  <scm>
    <connection>scm:git:git://github.com/exoplatform/email-connector.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/exoplatform/email-connector.git</developerConnection>
    <url>https://github.com/exoplatform/email-connector</url>
    <tag>HEAD</tag>
  </scm>
  <properties>
    <!-- 3rd party libraries versions -->
    <org.exoplatform.commons-exo.version>7.3.x-meeds-qaui-SNAPSHOT</org.exoplatform.commons-exo.version>
    <io.meeds.mcp-server.version>7.3.x-meeds-qaui-SNAPSHOT</io.meeds.mcp-server.version>
    <!-- vCard parsing for the CardDAV address book sync -->
    <ez-vcard.version>0.12.1</ez-vcard.version>
    <!-- Sonar properties -->
    <sonar.organization>exoplatform</sonar.organization>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.exoplatform.commons-exo</groupId>
        <artifactId>commons-exo</artifactId>
        <version>${org.exoplatform.commons-exo.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Import versions from MCP Server project (used by the email MCP tools exposed to the AI agent) -->
      <dependency>
        <groupId>io.meeds.mcp-server</groupId>
        <artifactId>mcp-server</artifactId>
        <version>${io.meeds.mcp-server.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- TEMPORARY: the version belongs in maven-exo-depmgt-pom, where it is
           declared by https://github.com/exoplatform/maven-exo-depmgt-pom/pull/30.
           This block goes away once that lands and a snapshot is published, leaving
           the module to reference the artifact versionless. It is here only so this
           branch builds while that PR is in review.

           vCard parsing for the CardDAV address book sync. The three excluded
           dependencies serve vCard's HTML (hCard, needs jsoup + freemarker) and JSON
           (jCard, needs jackson) representations, which an address book never uses:
           CardDAV carries plain vCard. commons-codec and vinnie are kept: the first
           decodes base64 photos, the second is the parser's own reader/writer core. -->
      <dependency>
        <groupId>com.googlecode.ez-vcard</groupId>
        <artifactId>ez-vcard</artifactId>
        <version>${ez-vcard.version}</version>
        <exclusions>
          <exclusion>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
          </exclusion>
          <exclusion>
            <groupId>org.freemarker</groupId>
            <artifactId>freemarker</artifactId>
          </exclusion>
          <exclusion>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <!-- Current project artifacts -->
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>email-connector-services</artifactId>
        <version>${project.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>email-connector-webapps</artifactId>
        <version>${project.version}</version>
        <scope>provided</scope>
        <type>war</type>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>email-connector-packaging</artifactId>
        <version>${project.version}</version>
        <scope>provided</scope>
        <type>zip</type>
      </dependency>
    </dependencies>
  </dependencyManagement>
  
  <!-- This profile is used to allow github action to build branches. The github action is used for sonar analysis -->
  <profiles>
    <profile>
      <id>project-repositories</id>
      <activation>
        <property>
          <name>!skip-project-repositories</name>
        </property>
      </activation>
      <repositories>
        <repository>
          <snapshots>
            <enabled>true</enabled>
          </snapshots>
          <id>repository.exoplatform.org</id>
          <url>https://repository.exoplatform.org/public</url>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <snapshots>
            <enabled>true</enabled>
          </snapshots>
          <id>repository.exoplatform.org</id>
          <url>https://repository.exoplatform.org/public</url>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
</project>
