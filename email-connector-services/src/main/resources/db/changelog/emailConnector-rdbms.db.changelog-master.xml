<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">


  <!-- Managing both DB that use sequences and db that use auto increment -->
  <property name="autoIncrement" value="true" dbms="mysql,mssql,h2,sybase,db2,hsqldb"/>
  <property name="autoIncrement" value="false" dbms="oracle,postgresql"/>
  
  <changeSet author="email-connector" id="1.0.0-0" dbms="oracle,postgresql,hsqldb">
    <createSequence sequenceName="SEQ_EMAIL_CONNECTOR_ID" startValue="1"/>
  </changeSet>

  <changeSet author="email-connector" id="1.0.0-1">
    <createTable tableName="EMAIL_CONNECTOR">
      <column name="ID" type="BIGINT" autoIncrement="${autoIncrement}" startWith="1">
        <constraints nullable="false" primaryKey="true" primaryKeyName="PK_EMAIL_CONNECTOR"/>
      </column>
      <column name="NAME" type="NVARCHAR(250)">
        <constraints nullable="false"/>
      </column>
      <column name="IMAGE_FILE_ID" type="BIGINT">
      </column>
      <column name="ICON" type="NVARCHAR(500)">
      </column>
      <column name="IMAP_URL" type="NVARCHAR(250)">
        <constraints nullable="false"/>
      </column>
      <column name="PORT" type="NVARCHAR(50)">
        <constraints nullable="false"/>
      </column>
      <column name="ACTIVE" type="BOOLEAN" defaultValueBoolean="true">
        <constraints nullable="false" />
      </column>
    </createTable>
    <modifySql dbms="mysql">
      <append value=" ENGINE=INNODB CHARSET=UTF8 COLLATE utf8_general_ci"/>
    </modifySql>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-2">
    <createTable tableName="EMAIL_BOX">
      <column name="ID" type="BIGINT" autoIncrement="${autoIncrement}" startWith="1">
        <constraints nullable="false" primaryKey="true" primaryKeyName="PK_EMAIL_BOX"/>
      </column>
      <column name="MAIL_REMOTE_ID" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="USER_ID" type="VARCHAR(250)">
        <constraints nullable="false"/>
      </column>
      <column name="SUBJECT" type="VARCHAR(1024)">
      </column>
      <column name="EXCERPT" type="VARCHAR(1024)">
      </column>
      <column name="SENDER" type="VARCHAR(250)">
        <constraints nullable="false"/>
      </column>
      <column name="SENT_DATE" type="TIMESTAMP">
        <constraints nullable="false" />
      </column>
    </createTable>
    <modifySql dbms="mysql">
      <append value=" ENGINE=INNODB CHARSET=UTF8MB4 COLLATE utf8mb4_0900_ai_ci" />
    </modifySql>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-3" dbms="oracle,postgresql,hsqldb">
    <createSequence sequenceName="SEQ_EMAIL_ID" startValue="1"/>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-4">
    <addColumn tableName="EMAIL_BOX">
      <column name="IS_READ" type="BOOLEAN" defaultValueBoolean="false"/>
    </addColumn>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-5">
    <validCheckSum>ANY</validCheckSum>
    <createTable tableName="EMAIL_ATTACHMENTS">
      <column name="ID" type="BIGINT" autoIncrement="${autoIncrement}" startWith="1">
        <constraints nullable="false" primaryKey="true" primaryKeyName="PK_EMAIL_ATTACHMENTS"/>
      </column>
      <column name="MAIL_ID" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="ATTACHMENT_REMOTE_ID" type="VARCHAR(250)">
        <constraints nullable="false"/>
      </column>
      <column name="NAME" type="VARCHAR(1024)">
        <constraints nullable="false"/>
      </column>
      <column name="MIME_TYPE" type="VARCHAR(250)">
        <constraints nullable="false" />
      </column>
    </createTable>
    <modifySql dbms="mysql">
      <append value=" ENGINE=INNODB CHARSET=UTF8MB4 COLLATE utf8mb4_0900_ai_ci" />
    </modifySql>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-6">
    <addForeignKeyConstraint 
      baseTableName="EMAIL_ATTACHMENTS"
      baseColumnNames="MAIL_ID"
      referencedTableName="EMAIL_BOX"
      referencedColumnNames="ID"
      constraintName="FK_EMAIL_ATTACHMENTS_MAIL_ID"
      onDelete="CASCADE"/>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-7">
    <renameColumn
      tableName="EMAIL_BOX"
      oldColumnName="SENT_DATE"
      newColumnName="RECIEVED_DATE"
      columnDataType="TIMESTAMP" />
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-8">
    <renameColumn
      tableName="EMAIL_BOX"
      oldColumnName="EXCERPT"
      newColumnName="BODY"
      columnDataType="LONGTEXT" />
    <addColumn tableName="EMAIL_BOX">
      <column name="RECIEVER" type="VARCHAR(1024)"/>
      <column name="CC" type="VARCHAR(1024)"/>
      <column name="BCC" type="VARCHAR(1024)"/>
    </addColumn>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-9">
     <modifyDataType 
      tableName="EMAIL_BOX" 
      columnName="RECIEVER" 
      newDataType="LONGTEXT" />
     <modifyDataType 
      tableName="EMAIL_BOX" 
      columnName="CC" 
      newDataType="LONGTEXT" />
     <modifyDataType 
      tableName="EMAIL_BOX" 
      columnName="BCC" 
      newDataType="LONGTEXT" />
    <renameColumn
      tableName="EMAIL_BOX"
      oldColumnName="RECIEVED_DATE"
      newColumnName="RECEIVED_DATE" 
      columnDataType="TIMESTAMP" />
    <renameColumn
      tableName="EMAIL_BOX"
      oldColumnName="RECIEVER"
      newColumnName="RECEIVER"
      columnDataType="LONGTEXT" />
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-10">
    <renameColumn
      tableName="EMAIL_CONNECTOR"
      oldColumnName="PORT"
      newColumnName="IMAP_PORT" 
      columnDataType="NVARCHAR(50)" />
    <addColumn tableName="EMAIL_CONNECTOR">
      <column name="SMTP_URL" type="NVARCHAR(250)"/>
      <column name="SMTP_PORT" type="NVARCHAR(50)"/>
      <column name="SMTP_SECURITY_TYPE" type="NVARCHAR(50)"/>
    </addColumn>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-11">
    <addColumn tableName="EMAIL_BOX">
      <column name="MAIL_HEADER_ID" type="VARCHAR(1024)"/>
    </addColumn>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-12" dbms="hsqldb">
    <modifyDataType tableName="EMAIL_BOX" columnName="BODY" newDataType="CLOB"/>
    <modifyDataType tableName="EMAIL_BOX" columnName="RECEIVER" newDataType="CLOB"/>
    <modifyDataType tableName="EMAIL_BOX" columnName="CC" newDataType="CLOB"/>
    <modifyDataType tableName="EMAIL_BOX" columnName="BCC" newDataType="CLOB"/>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-13">
    <addColumn tableName="EMAIL_BOX">
      <column name="RECENT" type="BOOLEAN" defaultValueBoolean="false"/>
    </addColumn>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-14">
    <addColumn tableName="EMAIL_BOX">
      <column name="REPLY_TO" type="VARCHAR(1024)"/>
    </addColumn>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-15">
     <modifyDataType 
      tableName="EMAIL_BOX" 
      columnName="SUBJECT" 
      newDataType="TEXT" />
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-16" dbms="postgresql">
    <modifyDataType 
      tableName="EMAIL_BOX" 
      columnName="BODY" 
      newDataType="TEXT" />
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-17">
    <addColumn tableName="EMAIL_CONNECTOR">
      <column name="WEB_MAIL_URL" type="NVARCHAR(250)"/>
    </addColumn>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-18">
    <addColumn tableName="EMAIL_BOX">
      <!-- THREAD_ID stays at 255 so (USER_ID, THREAD_ID) fits a MySQL index key; a
           Message-ID is practically well under that. IN_REPLY_TO holds one id;
           MAIL_REFERENCES can carry a long chain, hence TEXT (as SUBJECT in 1.0.0-15). -->
      <column name="THREAD_ID" type="VARCHAR(255)"/>
      <column name="IN_REPLY_TO" type="VARCHAR(1024)"/>
      <column name="MAIL_REFERENCES" type="TEXT"/>
    </addColumn>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-19">
    <createIndex tableName="EMAIL_BOX" indexName="IDX_EMAIL_BOX_USER_ID">
      <column name="USER_ID"/>
    </createIndex>
    <createIndex tableName="EMAIL_BOX" indexName="IDX_EMAIL_BOX_USER_THREAD">
      <column name="USER_ID"/>
      <column name="THREAD_ID"/>
    </createIndex>
  </changeSet>
</databaseChangeLog>