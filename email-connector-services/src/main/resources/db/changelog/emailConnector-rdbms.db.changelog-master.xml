  </changeSet>
  <changeSet author="email-connector" id="1.0.0-17">
    <addColumn tableName="EMAIL_CONNECTOR">
      <column name="WEB_MAIL_URL" type="NVARCHAR(250)"/>
    </addColumn>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-18">
    <addColumn tableName="EMAIL_BOX">
      <!-- THREAD_ID stays at 255 so (USER_ID, THREAD_ID) fits a MySQL index key; a
           Message-ID is practically well under that. IN_REPLY_TO holds one id;
           MAIL_REFERENCES can carry a long chain, hence TEXT (as SUBJECT in 1.0.0-15). -->
      <column name="THREAD_ID" type="VARCHAR(255)"/>
      <column name="IN_REPLY_TO" type="VARCHAR(1024)"/>
      <column name="MAIL_REFERENCES" type="TEXT"/>
    </addColumn>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-19">
    <createIndex tableName="EMAIL_BOX" indexName="IDX_EMAIL_BOX_USER_ID">
      <column name="USER_ID"/>
    </createIndex>
    <createIndex tableName="EMAIL_BOX" indexName="IDX_EMAIL_BOX_USER_THREAD">
      <column name="USER_ID"/>
      <column name="THREAD_ID"/>
    </createIndex>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-20">
    <!-- Which remote folder a cached message belongs to (INBOX / SENT / ARCHIVE).
         IMAP UIDs are per-folder, so the cache key becomes (USER_ID, FOLDER,
         MAIL_REMOTE_ID). Existing rows are all INBOX. -->
    <addColumn tableName="EMAIL_BOX">
      <column name="FOLDER" type="VARCHAR(50)" defaultValue="INBOX">
        <constraints nullable="false"/>
      </column>
    </addColumn>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-21">
    <!-- Exchange Thread-Index conversation-root GUID (hex, 32 chars). Lets a reply
         join its conversation even when the References chain is broken (subject
         changes, external forwards). Indexed with USER_ID for the sibling lookup. -->
    <addColumn tableName="EMAIL_BOX">
      <column name="THREAD_INDEX_ROOT" type="VARCHAR(64)"/>
    </addColumn>
    <createIndex tableName="EMAIL_BOX" indexName="IDX_EMAIL_BOX_USER_THREAD_INDEX">
      <column name="USER_ID"/>
      <column name="THREAD_INDEX_ROOT"/>
    </createIndex>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-22">
    <!-- The bulk-mail signals, read from the standard headers at sync time while the
         MimeMessage is still at hand. Consumers only see the cached row, so without these the
         only way to guess is to search the body for the word "unsubscribe", which also matches
         signatures, mailing list footers and quoted replies, and so mislabels genuine human
         mail. Existing rows default to false and are corrected on their next sync.
         Stored as separate facts rather than one derived verdict, because they do not mean the
         same thing: Auto-Submitted and Precedence say "no human wrote this", while
         List-Unsubscribe only says "this travelled through bulk distribution machinery" - a
         mailing list stamps it on every message it relays, including one a colleague typed by
         hand. Collapsing them into a single flag made list traffic indistinguishable from
         marketing and filed genuine business mail as automated. List-Id plus a postable
         List-Post is what actually identifies a mailing list, since marketing senders rarely
         set List-Post. Keeping the raw facts means the classification rule can be changed
         without re-downloading every mailbox.
         Upstream reached this shape in two steps - a single BULK_MAIL flag, then its
         replacement by these four - which is why feature/ai-contribution carries both an add
         and a drop. Neither has ever run on this lineage, so they are collapsed here rather
         than backported literally: replaying them would add a NOT NULL column to EMAIL_BOX and
         drop it again on every install and every upgrade, for a column no code ever reads. -->
    <addColumn tableName="EMAIL_BOX">
      <column name="AUTO_SUBMITTED" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="HAS_LIST_ID" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="HAS_LIST_POST" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="HAS_LIST_UNSUBSCRIBE" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
    </addColumn>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-23">
    <!-- Who actually wrote a message that arrived through a mailing list. Google Groups and
         Mailman rewrite From to the list itself ("Name via the-list <the-list@example.com>"),
         so the stored sender identifies the transport, not the author - and a colleague's
         message then looks exactly like a newsletter relayed into the same group. The original
         address survives in X-Original-Sender; without it, anything list-borne is
         indistinguishable. Empty for directly-delivered mail. -->
    <addColumn tableName="EMAIL_BOX">
      <column name="ORIGINAL_SENDER" type="VARCHAR(320)"/>
    </addColumn>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-24">
    <!-- The reconcile view this change introduced (findSyncViewByUserIdAndFolder) runs on
         every routine sync of every connected mailbox: it filters on (USER_ID, FOLDER) and
         sorts on RECEIVED_DATE. The indexes above cover USER_ID, (USER_ID, THREAD_ID) and
         (USER_ID, THREAD_INDEX_ROOT) - none covers FOLDER or RECEIVED_DATE, so the database
         range-scans USER_ID alone and filters and sorts the rest in memory. That is a whole
         mailbox's rows on the hottest query of the sync path, at a cache size that now
         defaults to 1000 and that administrators may raise to 5000. -->
    <createIndex tableName="EMAIL_BOX" indexName="IDX_EMAIL_BOX_USER_FOLDER_DATE">
      <column name="USER_ID"/>
      <column name="FOLDER"/>
      <column name="RECEIVED_DATE"/>
    </createIndex>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-25" dbms="oracle,postgresql,hsqldb">
    <createSequence sequenceName="SEQ_EMAIL_CONTACT_ID" startValue="1"/>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-26">
    <!-- Local mirror of the IMAP Flagged flag (the "star"). The flag on the server is the
         source of truth: the sync overwrites this column with whatever the server says, so
         a star set in any other mail client shows here and a star set here is pushed back.
         Existing rows default to false and are corrected on their next sync. -->
    <addColumn tableName="EMAIL_BOX">
      <column name="STARRED" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
    </addColumn>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-27">
    <!-- The per-user contact store. Rows are collected from the user's own cached mail
         (SOURCE=COLLECTED), typed by hand (MANUAL), or synced from a CardDAV address
         book (CARDDAV, phase 3). The lowercased PRIMARY_EMAIL with USER_ID is the
         natural key: the same person arriving from several sources resolves in place
         on the one row. SUPPRESSED is the tombstone for "remove a collected contact":
         a hard delete would only see the row re-collected on the next mail from that
         person. SORT_BUCKET is the alphabetical bucket (0..25 = A..Z of the
         diacritic-stripped sort key, 26 = everything else): ordering by an integer
         keeps the letter buckets contiguous on every dialect, where ordering
         punctuation and non-Latin scripts against letters is collation-dependent.
         EMAILS and PHONES are semicolon-joined value lists (the EMAIL_BOX recipients
         precedent) and stay VARCHAR so they remain LIKE-searchable on HSQLDB.
         HREF / ETAG / VCARD_UID / CONNECTOR_ID / PHOTO_FILE_ID / ORGANIZATION / TITLE
         are the CardDAV bookkeeping seam, null until phase 3 fills them. -->
    <createTable tableName="EMAIL_CONTACT">
      <column name="ID" type="BIGINT" autoIncrement="${autoIncrement}" startWith="1">
        <constraints nullable="false" primaryKey="true" primaryKeyName="PK_EMAIL_CONTACT"/>
      </column>
      <column name="USER_ID" type="VARCHAR(250)">
        <constraints nullable="false"/>
      </column>
      <column name="SOURCE" type="VARCHAR(20)">
        <constraints nullable="false"/>
      </column>
      <column name="PRIMARY_EMAIL" type="VARCHAR(320)">
        <constraints nullable="false"/>
      </column>
      <column name="EMAILS" type="VARCHAR(2000)"/>
      <column name="DISPLAY_NAME" type="NVARCHAR(500)"/>
      <column name="GIVEN_NAME" type="NVARCHAR(250)"/>
      <column name="FAMILY_NAME" type="NVARCHAR(250)"/>
      <column name="SORT_NAME" type="NVARCHAR(255)"/>
      <column name="SORT_BUCKET" type="INT" defaultValueNumeric="26">
        <constraints nullable="false"/>
      </column>
      <column name="PHONES" type="VARCHAR(500)"/>
      <column name="ORGANIZATION" type="NVARCHAR(250)"/>
      <column name="TITLE" type="NVARCHAR(250)"/>
      <column name="PHOTO_FILE_ID" type="BIGINT"/>
      <column name="HREF" type="VARCHAR(1000)"/>
      <column name="ETAG" type="VARCHAR(250)"/>
      <column name="VCARD_UID" type="VARCHAR(250)"/>
      <column name="CONNECTOR_ID" type="BIGINT"/>
      <column name="SUPPRESSED" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="SEEN_COUNT" type="BIGINT" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="LAST_SEEN_DATE" type="TIMESTAMP"/>
      <column name="CREATED_DATE" type="TIMESTAMP"/>
      <column name="UPDATED_DATE" type="TIMESTAMP"/>
    </createTable>
    <modifySql dbms="mysql">
      <append value=" ENGINE=INNODB CHARSET=UTF8MB4 COLLATE utf8mb4_0900_ai_ci" />
    </modifySql>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-28">
    <createIndex tableName="EMAIL_CONTACT" indexName="IDX_EMAIL_CONTACT_USER_ID">
      <column name="USER_ID"/>
    </createIndex>
    <createIndex tableName="EMAIL_CONTACT" indexName="UQ_EMAIL_CONTACT_USER_EMAIL" unique="true">
      <column name="USER_ID"/>
      <column name="PRIMARY_EMAIL"/>
    </createIndex>
    <createIndex tableName="EMAIL_CONTACT" indexName="IDX_EMAIL_CONTACT_USER_SORT">
      <column name="USER_ID"/>
      <column name="SORT_BUCKET"/>
      <column name="SORT_NAME"/>
    </createIndex>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-29">
    <!-- The platform identity a DIRECTORY row links to. Imported colleagues are
         stored as a LINK (this username), not a copy: name, avatar and address
         resolve live from the profile at read time, so a rename or a departure
         never rots into a stale snapshot. The name/email columns of such a row
         are only the fallback shown when the profile is gone. -->
    <addColumn tableName="EMAIL_CONTACT">
      <column name="PLATFORM_USERNAME" type="VARCHAR(250)"/>
    </addColumn>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-30">
    <!-- Where this provider's address book lives, so contacts can be read over
         CardDAV. It sits on the connector beside the IMAP and SMTP endpoints
         because it IS the same provider's third endpoint, not a different server:
         one preset per provider stays one thing for an administrator to maintain.
         Null means this provider offers no address book, which is the honest state
         for Microsoft 365 and Proton, and the default for everyone else. -->
    <addColumn tableName="EMAIL_CONNECTOR">
      <column name="CARDDAV_URL" type="NVARCHAR(500)"/>
    </addColumn>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-31">
    <!-- Who owns a contact's picture: USER when somebody set it by hand here,
         VCARD when the address-book sync wrote it. Without this the two are
         indistinguishable, and the sync would either overwrite a picture the user
         chose or never be able to refresh its own. Existing rows are all USER by
         definition, the sync not existing yet, and a null reads as USER. -->
    <addColumn tableName="EMAIL_CONTACT">
      <column name="PHOTO_ORIGIN" type="VARCHAR(10)"/>
    </addColumn>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-32" dbms="oracle,postgresql,hsqldb">
    <createSequence sequenceName="SEQ_EMAIL_CONTACT_ADDRESS_ID" startValue="1"/>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-33">
    <!-- A contact's addresses, one row each.
         Until now the address WAS the contact: EMAIL_CONTACT was unique on
         (USER_ID, PRIMARY_EMAIL), which made a person without an address
         unrepresentable. Mail always brought one, so it held; an address book does
         not. A Google address book of 496 entries produced 132 contacts because
         the rest carry a phone and no mail address, and those people are exactly
         the ones somebody wants to find in a contact list.
         So identity moves to the row, and addresses become what they are: zero or
         more attributes of a person. The unique index lives here now, which keeps
         de-duplication a database fact rather than a service promise, and keeps
         the lookup collection performs on every synced message a single indexed
         read. -->
    <createTable tableName="EMAIL_CONTACT_ADDRESS">
      <column name="ID" type="BIGINT" autoIncrement="${autoIncrement}" startWith="1">
        <constraints nullable="false" primaryKey="true" primaryKeyName="PK_EMAIL_CONTACT_ADDRESS"/>
      </column>
      <column name="CONTACT_ID" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <!-- Denormalised from the contact so uniqueness and lookup are one index on
           this table, without a join back on the hot path. -->
      <column name="USER_ID" type="VARCHAR(250)">
        <constraints nullable="false"/>
      </column>
      <column name="ADDRESS" type="VARCHAR(320)">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <createIndex tableName="EMAIL_CONTACT_ADDRESS" indexName="UQ_EMAIL_CONTACT_ADDRESS" unique="true">
      <column name="USER_ID"/>
      <column name="ADDRESS"/>
    </createIndex>
    <createIndex tableName="EMAIL_CONTACT_ADDRESS" indexName="IDX_EMAIL_CONTACT_ADDRESS_CONTACT">
      <column name="CONTACT_ID"/>
    </createIndex>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-34">
    <!-- Every address already stored becomes a row of its own. The secondary ones
         live inside the EMAILS string and cannot be split in SQL; an upgrade plugin
         does those, and this handles the primary address, which is the one every
         lookup uses today. -->
    <sql>INSERT INTO EMAIL_CONTACT_ADDRESS (ID, CONTACT_ID, USER_ID, ADDRESS)
         SELECT ID, ID, USER_ID, PRIMARY_EMAIL FROM EMAIL_CONTACT WHERE PRIMARY_EMAIL IS NOT NULL</sql>
  </changeSet>
  <changeSet author="email-connector" id="1.0.0-35">
    <!-- The address is no longer the identity, so the contact stops being unique on
         it and stops requiring one at all. PRIMARY_EMAIL stays as the preferred
         address a contact is shown and written to by, which every list and the
         compose hand-off already read; it is now a display choice rather than a key,
         and it is null for a contact who has only a phone number. -->
    <dropIndex tableName="EMAIL_CONTACT" indexName="UQ_EMAIL_CONTACT_USER_EMAIL"/>
    <dropNotNullConstraint tableName="EMAIL_CONTACT" columnName="PRIMARY_EMAIL" columnDataType="VARCHAR(320)"/>
    <createIndex tableName="EMAIL_CONTACT" indexName="IDX_EMAIL_CONTACT_USER_EMAIL">
      <column name="USER_ID"/>
      <column name="PRIMARY_EMAIL"/>
    </createIndex>
  </changeSet>
</databaseChangeLog>
