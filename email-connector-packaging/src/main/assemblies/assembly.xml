<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2 http://maven.apache.org/xsd/assembly-1.1.2.xsd">
  <id>kudos</id>
  <formats>
    <format>zip</format>
  </formats>
  <includeBaseDirectory>false</includeBaseDirectory>
  <dependencySets>
    <!-- War -->
    <dependencySet>
      <useProjectArtifact>false</useProjectArtifact>
      <outputDirectory>/</outputDirectory>
      <includes>
        <include>${project.groupId}:email-connector-webapps:war</include>
      </includes>
      <scope>provided</scope>
      <outputFileNameMapping>email-connector.war</outputFileNameMapping>
    </dependencySet>
    <!-- Libraries -->
    <dependencySet>
      <useProjectArtifact>false</useProjectArtifact>
      <outputDirectory>/</outputDirectory>
      <includes>
        <include>${project.groupId}:*:jar</include>
        <include>backport-util-concurrent:backport-util-concurrent:jar</include>
        <include>org.mnode.ical4j:ical4j:jar</include>
        <include>javax.cache:cache-api:jar</include>
        <!-- The vCard parser and vinnie, its reader/writer core. Its third runtime
             dependency, commons-codec, is already shipped by the platform, so it is
             deliberately not duplicated here. The include list is exhaustive, so a
             jar left out of it produces a NoClassDefFoundError at runtime rather
             than a build failure: check the zip, do not assume. -->
        <include>com.googlecode.ez-vcard:ez-vcard:jar</include>
        <include>com.github.mangstadt:vinnie:jar</include>
      </includes>
      <scope>provided</scope>
      <outputFileNameMapping>${artifact.artifactId}.${artifact.extension}</outputFileNameMapping>
    </dependencySet>
  </dependencySets>
</assembly>