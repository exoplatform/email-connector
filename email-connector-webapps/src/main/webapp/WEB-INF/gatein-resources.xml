    <depends>
      <module>commonVueComponents</module>
    </depends>
    <depends>
      <module>extensionRegistry</module>
    </depends>
    <!-- The platform's profile-picture cropper, which registers
         <image-crop-drawer>: the contact form borrows it whole rather than
         growing a second, differently-behaved picture editor. -->
    <depends>
      <module>imageCropper</module>
    </depends>
    <!-- The platform's own QR library, which draws the take-away code on a
         contact card. Declared even though the dialog requires it on demand:
         requirejs only knows a shared module on a page where something depends
         on it, so without this the require resolved to nothing and the dialog
         opened empty. -->
    <depends>
      <module>qrcode</module>
    </depends>
  </module>

