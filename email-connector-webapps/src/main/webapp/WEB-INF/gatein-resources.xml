  </module>

  <!-- Contributes "Add to contacts" (on a vCard chat attachment) and "Contact"
       (in the composer's "+" menu) to the chat's ('chat', 'message-action') and
       ('chat', 'composer-action') extension points. The name MUST contain
       "ChatActionExtension": the chat discovers its contributors by module name
       (see matrix's vue-apps/matrix/js/ChatActionExtensions.js), so a module that
       merely sits in the load-group is defined and then never executed. In
       matrixGRP so it is present wherever the chat renders — the discussion
       drawer and the full chat page both come from the same Matrix portlet.
       Present only when this webapp is deployed; the chat needs no change. -->
  <module>
    <name>EmailConnectorChatActionExtension</name>
    <load-group>matrixGRP</load-group>
    <script>
      <path>/js/emailConnectorChatActionExtension.bundle.js</path>
    </script>
    <depends>
      <module>vue</module>
    </depends>
    <depends>
      <module>vuetify</module>
    </depends>
    <depends>
      <module>eXoVueI18n</module>
    </depends>
    <depends>
      <module>commonVueComponents</module>
    </depends>
    <depends>
      <module>extensionRegistry</module>
    </depends>
    <!-- The platform's profile-picture cropper: the contact form drawer this
         bundle carries renders <image-crop-drawer>, same as in the contacts app. -->
    <depends>
      <module>imageCropper</module>
    </depends>
  </module>

  <!-- Contributes the "Emails" section to the platform's global Favorites drawer. The
       name MUST contain "FavoriteDrawerExtension": the favorites portlet discovers its
       contributors with includeExtensions('FavoriteDrawerExtension'), which matches on
       the module name, so a module that merely sits in the load-group is defined and
       then never executed. In FavoriteDrawerGRP so it loads with that drawer. -->
  <module>
    <name>EmailConnectorFavoriteDrawerExtension</name>
    <load-group>FavoriteDrawerGRP</load-group>
    <script>
      <path>/js/emailConnectorFavoriteDrawerExtension.bundle.js</path>
    </script>
    <depends>
      <module>vue</module>
    </depends>
    <depends>
      <module>vuetify</module>
    </depends>
    <depends>
      <module>eXoVueI18n</module>
    </depends>
    <depends>
      <module>commonVueComponents</module>
    </depends>
    <depends>
      <module>extensionRegistry</module>
    </depends>
  </module>

  <!-- The "Add to my contacts" action on the PROFILE HEADER — and nowhere else.
       Two halves:

       1. The always-on head script below (top-level <javascript>) registers the
          descriptor into social's ('profile-header', 'action-component') point —
          the point profileHeader.bundle.js snapshots ONCE in a module-scope
          const, with no *-updated listener: registration MUST precede that AMD
          factory, which only a synchronous head script guarantees (the same
          mechanism as webconferencing's call button, this point's only other
          registrant). NOT the shared ('profile-extension', 'action') point,
          which the people list, search results, org chart and popovers render
          too.

       2. The module here holds the real code (i18n, user checks, the button),
          required lazily by name from the descriptor's init(container,
          username). The name deliberately does NOT contain "PopoverExtension":
          the popover portlet's includeExtensions('PopoverExtension') matches on
          module NAME, and this module must no longer run on card surfaces. It
          stays in popoverGRP only so requirejs knows the name on every page the
          globally-injected popover portlet reaches — the profile page included
          (a shared module is only addressable where something on the page
          carries it; it stays defined-not-executed until init() requires it). -->
  <javascript>
    <param>
      <js-module>emailConnectorProfileHeaderPlugin</js-module>
      <js-path>/js/emailConnectorProfileHeaderPlugin.js</js-path>
    </param>
  </javascript>
  <module>
    <name>EmailConnectorProfileHeaderAction</name>
    <load-group>popoverGRP</load-group>
    <script>
      <path>/js/emailConnectorProfileExtension.bundle.js</path>
    </script>
    <!-- init() mounts a Vuetify app of its own, so this module needs vue and vuetify
         in its own right. They are already on every page that can reach this code, so
         declaring them costs nothing and stops the module being correct only by virtue
         of the profile-header portlet's environment. -->
    <depends>
      <module>vue</module>
    </depends>
    <depends>
      <module>vuetify</module>
    </depends>
    <!-- Required lazily as SHARED/eXoVueI18n from init(): requirejs only knows a
         shared module on a page where something depends on it. -->
    <depends>
      <module>eXoVueI18n</module>
    </depends>
  </module>

  <!-- The unified-search connector's front-end half. The connector descriptor names
       it as SHARED/EmailSearch, so the module name here IS that contract: the search
       app requires it to register the row component and to call formatSearchResult on
       our REST answer. No load-group: it is required by name, when a search runs. -->
  <module>
    <name>EmailSearch</name>
    <script>
      <path>/js/emailSearch.bundle.js</path>
    </script>
    <depends>
      <module>vue</module>
    </depends>
    <depends>
      <module>vuetify</module>
    </depends>
    <depends>
      <module>eXoVueI18n</module>
    </depends>
    <depends>
      <module>commonVueComponents</module>
    </depends>
  </module>

  <!-- The "My contacts" search connector's front-end half, on the same contract
       as EmailSearch above: the connector descriptor names SHARED/EmailContactsSearch,
       the search app requires it by that name to register the person card and map
       our REST answer. No load-group: required by name, when a search runs. -->
  <module>
    <name>EmailContactsSearch</name>
    <script>
      <path>/js/emailContactsSearch.bundle.js</path>
    </script>
    <depends>
      <module>vue</module>
    </depends>
    <depends>
      <module>vuetify</module>
    </depends>
    <depends>
      <module>eXoVueI18n</module>
    </depends>
    <depends>
      <module>commonVueComponents</module>
    </depends>
  </module>
