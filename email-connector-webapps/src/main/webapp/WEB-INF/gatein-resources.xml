<gatein-resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.exoplatform.org/xml/ns/gatein_resources_1_4 http://www.exoplatform.org/xml/ns/gatein_resources_1_4" xmlns="http://www.exoplatform.org/xml/ns/gatein_resources_1_4">
  
  <portlet>
    <name>EmailConnectorUserSetting</name>
    <module>
      <script>
        <minify>false</minify>
        <path>/js/emailConnectorUserSetting.bundle.js</path>
      </script>
      <depends>
        <module>vue</module>
      </depends>
      <depends>
        <module>eXoVueI18n</module>
      </depends>
      <depends>
        <module>vuetify</module>
      </depends>
      <depends>
        <module>commonVueComponents</module>
      </depends>
      <depends>
        <module>extensionRegistry</module>
      </depends>
      <depends>
        <module>emailConnectorCommon</module>
      </depends>
    </module>
  </portlet>

  <portlet>
    <name>EmailConnectorAdministration</name>
    <module>
      <script>
        <minify>false</minify>
        <path>/js/emailConnectorAdministration.bundle.js</path>
      </script>
      <depends>
        <module>vue</module>
      </depends>
      <depends>
        <module>eXoVueI18n</module>
      </depends>
      <depends>
        <module>vuetify</module>
      </depends>
      <depends>
        <module>commonVueComponents</module>
      </depends>
      <depends>
        <module>extensionRegistry</module>
      </depends>
      <depends>
        <module>translationField</module>
      </depends>
      <depends>
        <module>fontIcons</module>
      </depends>
      <depends>
        <module>emailConnectorCommon</module>
      </depends>
    </module>
  </portlet>

  <module>
    <name>emailConnectorQuickActionExtension</name>
    <load-group>QuickActionsGrp</load-group>
    <script>
      <minify>false</minify>
      <path>/js/emailConnectorMailBox.bundle.js</path>
    </script>
    <depends>
      <module>vue</module>
    </depends>
    <depends>
      <module>vuetify</module>
    </depends>
    <depends>
      <module>eXoVueI18n</module>
    </depends>
    <depends>
      <module>commonVueComponents</module>
    </depends>
    <depends>
      <module>extensionRegistry</module>
    </depends>
    <depends>
      <module>emailConnectorCommon</module>
    </depends>
	<depends>
      <module>categoryVueComponents</module>
    </depends>
  </module>

  <!-- The Contacts quick-action drawer: a sibling app to the mailbox, in the
       same QuickActionsGrp so its extension registers with the "+" menu. The
       app itself only mounts on first click. -->
  <module>
    <name>emailConnectorContactsQuickActionExtension</name>
    <load-group>QuickActionsGrp</load-group>
    <script>
      <minify>false</minify>
      <path>/js/emailConnectorContacts.bundle.js</path>
    </script>
    <depends>
      <module>vue</module>
    </depends>
    <depends>
      <module>vuetify</module>
    </depends>
    <depends>
      <module>eXoVueI18n</module>
    </depends>
    <depends>
      <module>commonVueComponents</module>
    </depends>
    <depends>
      <module>extensionRegistry</module>
    </depends>
    <!-- The platform's profile-picture cropper, which registers
         <image-crop-drawer>: the contact form borrows it whole rather than
         growing a second, differently-behaved picture editor. -->
    <depends>
      <module>imageCropper</module>
    </depends>
  </module>

  <module>
    <name>emailConnectorCommon</name>
	<load-group>EmailGrp</load-group>
    <script>
      <minify>false</minify>
      <path>/js/emailConnectorCommon.bundle.js</path>
    </script>
    <depends>
      <module>vue</module>
    </depends>
    <depends>
      <module>vuetify</module>
    </depends>
    <depends>
      <module>eXoVueI18n</module>
    </depends>
    <depends>
      <module>commonVueComponents</module>
    </depends>
    <depends>
      <module>extensionRegistry</module>
    </depends>
  </module>
  
  <module>
    <name>emailConnectorNotificationExtension</name>
    <load-group>notificationGRP</load-group>
    <script>
      <path>/js/emailConnectorNotificationExtension.bundle.js</path>
    </script>
    <depends>
      <module>vue</module>
    </depends>
    <depends>
      <module>vuetify</module>
    </depends>
    <depends>
      <module>eXoVueI18n</module>
    </depends>
    <depends>
      <module>extensionRegistry</module>
    </depends>
  </module>

  <!-- Contributes the "Send by email" action to the Documents file menu. The name
       MUST contain "DocumentsExtension": the Documents app discovers it via
       includeExtensions('DocumentsExtension'). In the DocumentsGRP load-group so it
       is present on the Documents pages. Present only when this webapp is deployed. -->
  <module>
    <name>EmailConnectorDocumentsExtension</name>
    <load-group>DocumentsGRP</load-group>
    <script>
      <path>/js/emailConnectorDocumentsExtension.bundle.js</path>
    </script>
    <depends>
      <module>vue</module>
    </depends>
    <depends>
      <module>vuetify</module>
    </depends>
    <depends>
      <module>eXoVueI18n</module>
    </depends>
    <depends>
      <module>commonVueComponents</module>
    </depends>
    <depends>
      <module>extensionRegistry</module>
    </depends>
  </module>

  <!-- Contributes the "Emails" section to the platform's global Favorites drawer. The
       name MUST contain "FavoriteDrawerExtension": the favorites portlet discovers its
       contributors with includeExtensions('FavoriteDrawerExtension'), which matches on
       the module name, so a module that merely sits in the load-group is defined and
       then never executed. In FavoriteDrawerGRP so it loads with that drawer. -->
  <module>
    <name>EmailConnectorFavoriteDrawerExtension</name>
    <load-group>FavoriteDrawerGRP</load-group>
    <script>
      <path>/js/emailConnectorFavoriteDrawerExtension.bundle.js</path>
    </script>
    <depends>
      <module>vue</module>
    </depends>
    <depends>
      <module>vuetify</module>
    </depends>
    <depends>
      <module>eXoVueI18n</module>
    </depends>
    <depends>
      <module>commonVueComponents</module>
    </depends>
    <depends>
      <module>extensionRegistry</module>
    </depends>
  </module>
</gatein-resources>
