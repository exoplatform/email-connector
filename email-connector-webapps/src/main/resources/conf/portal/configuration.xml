<configuration
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.exoplatform.org/xml/ns/kernel_1_2.xsd http://www.exoplatform.org/xml/ns/kernel_1_2.xsd"
  xmlns="http://www.exoplatform.org/xml/ns/kernel_1_2.xsd">
  
  <component>
    <type>org.exoplatform.emailConnector.notification.plugin.NewEmailsNotificationPwaPlugin</type>
  </component>

  <external-component-plugins>
    <target-component>org.exoplatform.commons.addons.AddOnService</target-component>
    <component-plugin>
      <name>addPlugin</name>
      <set-method>addPlugin</set-method>
      <type>org.exoplatform.commons.addons.AddOnPluginImpl</type>
      <description></description>
      <init-params>
        <value-param>
          <name>priority</name>
          <value>1</value>
        </value-param>
        <value-param>
          <name>containerName</name>
          <value>settings-bottom-container</value>
        </value-param>
        <object-param>
          <name>email-connector-user-settings</name>
          <description></description>
          <object type="org.exoplatform.commons.addons.PortletModel">
            <field name="contentId">
              <string>email-connector/EmailConnectorUserSetting</string>
            </field>
            <field name="permissions">
              <collection type="java.util.ArrayList">
                <value>
                  <string>*:/platform/users</string>
                </value>
                <value>
                  <string>*:/platform/externals</string>
                </value>
              </collection>
            </field>
            <field name="title">
              <string>Email Connector User Settings</string>
            </field>
            <field name="showInfoBar">
              <boolean>false</boolean>
            </field>
            <field name="showApplicationState">
              <boolean>false</boolean>
            </field>
            <field name="showApplicationMode">
              <boolean>false</boolean>
            </field>
          </object>
        </object-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>
  
  <external-component-plugins>
    <target-component>org.exoplatform.commons.file.services.NameSpaceService</target-component>
    <component-plugin>
      <name>EmailConnectorNameSpacePlugin</name>
      <set-method>addNameSpacePlugin</set-method>
      <type>org.exoplatform.commons.file.services.NameSpacePlugin</type>
      <init-params>
        <properties-param>
          <name>fileNameSpace.params</name>
          <property name="name" value="emailConnector" />
          <property name="description" value="emailConnector images" />
        </properties-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>
  
  <external-component-plugins>
    <target-component>org.exoplatform.commons.api.notification.service.setting.PluginSettingService</target-component>
    <component-plugin>
      <name>notification.groups</name>
      <set-method>registerGroupConfig</set-method>
      <type>org.exoplatform.commons.api.notification.plugin.GroupProviderPlugin</type>
      <description>Initial the default groups.</description>
      <init-params>
        <object-param>
          <name>group.email-connector</name>
          <description>The information of Notification group : componentUpdateState</description>
          <object type="org.exoplatform.commons.api.notification.plugin.config.GroupConfig">
            <field name="id">
              <string>email-connector</string>
            </field>
            <field name="resourceBundleKey">
              <string>UINotification.label.email</string>
            </field>
            <field name="order">
              <string>401</string>
            </field>
          </object>
        </object-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>

  <external-component-plugins>
    <target-component>org.exoplatform.commons.api.notification.service.setting.PluginContainer</target-component>
    <component-plugin>
      <name>notification.plugins</name>
      <set-method>addPlugin</set-method>
      <type>org.exoplatform.emailConnector.notification.plugin.NewEmailsNotificationPlugin</type>
      <description>Initial information for plugin NewEmailsNotificationPlugin</description>
      <init-params>
        <object-param>
          <name>template.NewEmailsNotificationPlugin</name>
          <description>The template for the plugin of new emails notification</description>
          <object type="org.exoplatform.commons.api.notification.plugin.config.PluginConfig">
            <field name="pluginId">
              <string>NewEmailsNotificationPlugin</string>
            </field>
            <field name="resourceBundleKey">
              <string>UINotification.label.newEmails</string>
            </field>
            <field name="order">
              <string>1</string>
            </field>
            <field name="defaultConfig">
              <collection type="java.util.ArrayList">
                <value>
                  <string>Instantly</string>
                </value>
              </collection>
            </field>
            <field name="groupId">
              <string>email-connector</string>
            </field>
            <field name="bundlePath">
              <string>locale.notification.emailConnectorNotification</string>
            </field>
            <field name="mutable">
              <boolean>false</boolean>
            </field>
          </object>
        </object-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>
  
  <external-component-plugins>
    <target-component>org.exoplatform.services.resources.ResourceBundleService</target-component>
    <component-plugin>
      <name>Email connector Plugin Resource Bundle</name>
      <set-method>addResourceBundle</set-method>
      <type>org.exoplatform.services.resources.impl.BaseResourceBundlePlugin</type>
      <init-params>
        <values-param>
          <name>classpath.resources</name>
          <value>locale.notification.emailConnectorNotification</value>
        </values-param>
        <values-param>
          <name>portal.resource.names</name>
          <value>locale.notification.emailConnectorNotification</value>
        </values-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>
  
  <external-component-plugins>
    <target-component>org.exoplatform.commons.api.notification.channel.ChannelManager</target-component>
    <component-plugin>
      <name>mail.channel.email-connector.template</name>
      <set-method>registerTemplateProvider</set-method>
      <type>org.exoplatform.emailConnector.notification.mail.MailTemplateProvider</type>
      <init-params>
        <value-param>
          <name>channel-id</name>
          <value>MAIL_CHANNEL</value>
        </value-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>
  
  <external-component-plugins>
    <target-component>org.exoplatform.commons.upgrade.UpgradeProductService</target-component>
    <component-plugin>
      <name>NewEmailsNotificationUpgradePlugin</name>
      <set-method>addUpgradePlugin</set-method>
      <type>io.meeds.social.notification.upgrade.NotificationUpgradePlugin</type>
      <description>An upgrade plugin to set a notification plugin </description>
      <init-params>
        <value-param>
          <name>product.group.id</name>
          <description>The groupId of the product</description>
          <value>org.exoplatform.social</value>
        </value-param>
        <value-param>
          <name>plugin.execution.order</name>
          <description>The plugin execution order</description>
          <value>5</value>
        </value-param>
        <value-param>
          <name>notificationPluginId</name>
          <description>Notification Plugin Id</description>
          <value>NewEmailsNotificationPlugin</value>
        </value-param>
        <value-param>
          <name>notificationChannelId</name>
          <description>Notification Channel Id, applied to all when empty</description>
          <value>WEB_CHANNEL</value>
        </value-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>

  <!-- Contributes mail to the platform's unified search (the global magnifying
       glass). The connector is a descriptor, not code: the search app substitutes
       {keyword} and {limit} into the uri below and renders each hit with the
       uiComponent this add-on ships.

       The uri is this add-on's own REST, not Elasticsearch — a federated connector,
       which the framework supports. It points at the CACHED search on purpose: the
       search app queries every connector at once and shows the page when the slowest
       answers, so reaching the mail server here would make every search in the
       platform wait on IMAP, including the ones that were never about email. The
       results offer "search all my mail" for the whole mailbox. -->
  <external-component-plugins>
    <target-component>org.exoplatform.social.core.search.SearchService</target-component>
    <component-plugin>
      <name>EmailSearchConnector</name>
      <set-method>addConnector</set-method>
      <type>org.exoplatform.social.core.search.SearchConnectorPlugin</type>
      <description>Search connector for emails</description>
      <init-params>
        <object-param>
          <name>EmailSearchConnector</name>
          <description>Search connector for emails</description>
          <object type="org.exoplatform.social.core.search.SearchConnector">
            <field name="name">
              <string>emails</string>
            </field>
            <field name="contentType">
              <string>email</string>
            </field>
            <field name="uri">
              <string><![CDATA[/email-connector/rest/email-box/search/cached?q={keyword}&limit={limit}]]></string>
            </field>
            <field name="enabled">
              <boolean>${exo.search.email.enabled:true}</boolean>
            </field>
            <field name="jsModule">
              <string>SHARED/EmailSearch</string>
            </field>
            <field name="i18nBundle">
              <string>locale.portlet.emailConnector.emailConnectorMailBox</string>
            </field>
            <field name="uiComponent">
              <string>email-search-result</string>
            </field>
            <field name="icon">
              <string>fas fa-envelope</string>
            </field>
            <!-- A mail belongs to one mailbox, not to a space, so the space filter
                 would only ever narrow it to nothing. -->
            <field name="spaceFilterEnabled">
              <boolean>false</boolean>
            </field>
          </object>
        </object-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>

</configuration>
